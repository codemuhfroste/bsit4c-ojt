{
  "name": "bsit4c-ojt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OJT requirements checklist for BSIT 4C",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mail:test": "node --env-file-if-exists=.env scripts/test-mail.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
