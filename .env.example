# Turso (hosted). Create with: turso db create bsit4c-ojt
#   turso db show bsit4c-ojt --url
#   turso db tokens create bsit4c-ojt
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Leave TURSO_DATABASE_URL unset to use a local SQLite file (local.db) for development.
PORT=3000
