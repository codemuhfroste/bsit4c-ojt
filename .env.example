# Turso (hosted). Create with: turso db create bsit4c-ojt
#   turso db show bsit4c-ojt --url
#   turso db tokens create bsit4c-ojt
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=
# Leave TURSO_DATABASE_URL unset to use a local SQLite file (local.db) for development.

PORT=3000
# Public URL of the site; used for links in verification / reset emails.
APP_URL=http://localhost:3000

# Comma-separated emails that are always admins (use this to create the first admin).
ADMIN_EMAILS=

# SMTP connection URL for real email, e.g. smtps://user:pass@smtp.example.com
# Leave unset in development: emails are printed to the server console instead.
SMTP_URL=
MAIL_FROM="BSIT 4C OJT <no-reply@example.com>"

# Set to 1 when running behind one reverse proxy so rate limiting sees real client IPs.
TRUST_PROXY=

# Who people can contact about their personal data (shown on the Privacy Notice). Defaults to the MAIL_FROM address.
PRIVACY_CONTACT=
